# CompetitorBreak configuration
# Copy to .env and adjust as needed.

# --- Database ---
# Default: SQLite (a local file). Path resolves from the project root.
DB_PATH=competitorbreak.db

# To use PostgreSQL instead, set EITHER a full URL ...
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# ... OR the individual parts (DATABASE_URL takes precedence if both are set):
# PGHOST=your.server.ip        # Server IP address / host
# PGPORT=5432
# PGUSER=your_username         # Username
# PGPASSWORD=your_password     # Password
# PGDATABASE=competitorank     # database name (must already exist)
# When any Postgres host is set, the app uses Postgres; otherwise it uses SQLite.

# --- Scraper settings ---
# Max blog posts to scrape per competitor per run
MAX_PAGES=300
# Seconds to wait between requests to the same site (politeness)
CRAWL_DELAY=1.0
# Respect robots.txt (true/false)
RESPECT_ROBOTS=true
