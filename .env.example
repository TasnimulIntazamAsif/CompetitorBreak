# CompetitorBreak configuration
# Copy to .env and adjust as needed.

# --- SQLite ---
# Path to the SQLite database file (relative paths resolve from the project root).
DB_PATH=competitorbreak.db

# --- Scraper settings ---
# Max blog posts to scrape per competitor per run
MAX_PAGES=300
# Seconds to wait between requests to the same site (politeness)
CRAWL_DELAY=1.0
# Respect robots.txt (true/false)
RESPECT_ROBOTS=true
